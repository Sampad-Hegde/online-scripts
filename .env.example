# Copy to .env  ->  every make target and docker compose picks it up:
#     cp .env.example .env && make prod-up
#
# Precedence:  make command line  >  shell environment  >  .env  >  defaults
#     make prod-up HOST_PORT=9000      # wins over .env
#     HOST_PORT=9000 make prod-up      # also wins over .env
#
# In Portainer there is no .env file: paste these into the stack's
# "Environment variables" box instead.
#
# Keep the syntax plain - KEY=value, no quotes, no $ substitution - because
# this file is read by make, by docker compose and by "docker run --env-file".

# host port the service listens on
HOST_PORT=8080

# full image reference used by the stack (registry/name:tag)
IMAGE=online-script:latest
APP_VERSION=1.0.0

# optional shared secret. when set, every request needs ?t=<token>
#   curl -fsSL 'https://hw.example.com/sysinfo.sh?t=CHANGEME' | sudo sh
# leave empty to keep the service open (fine on a LAN / VPN only)
AUTH_TOKEN=

# set when behind a reverse proxy, so the scripts print copy-pasteable URLs
# PUBLIC_BASE_URL=https://hw.example.com

LOG_LEVEL=INFO
TZ=UTC
