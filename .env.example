# copy to .env (docker compose reads it automatically) or paste these into
# Portainer's "Environment variables" box when creating the stack.

# host port the service listens on
HOST_PORT=8080

# image tag used by the stack
IMAGE=online-script:latest
APP_VERSION=1.0.0

# optional shared secret. when set, every request needs ?t=<token>
#   curl -fsSL https://hw.example.com/sysinfo.sh?t=CHANGEME | sudo sh
# leave empty to keep the service open (fine on a LAN / VPN only)
AUTH_TOKEN=

# set when behind a reverse proxy, so the scripts print copy-pasteable URLs
# PUBLIC_BASE_URL=https://hw.example.com

LOG_LEVEL=INFO
TZ=UTC
